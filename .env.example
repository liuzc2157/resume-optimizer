# ===== LLM 供应商配置 =====
# 预设：glm（默认）/ modelscope / siliconflow / deepseek / novita / openrouter
# 也可填任意值 + LLM_BASE_URL 自定义（vLLM / Ollama / 内网网关均可）
#
# 【免费优先推荐 · 2026-09 核实】
#   1. glm         → 智谱 glm-4-flash，官方承诺永久免费（需注册+实名）
#                    领 Key：open.bigmodel.cn → API 密钥管理
#   2. modelscope  → 魔搭 Tencent-Hunyuan/Hy3 等，每日约 2000 次免费调用
#                    领 Key：modelscope.cn → 账号设置 → API Token
#   3. siliconflow → 硅基流动 Qwen/Qwen3-8B 等小模型免费（需实名，有 RPM 限制）
#                    领 Key：cloud.siliconflow.cn
#   注：腾讯 Hy3 在 OpenRouter 的免费期已于 2026-07-21 结束，走 OpenRouter 需付费。
LLM_PROVIDER=glm

# 各平台密钥，填你实际领到的那个即可（只填一个就够）
GLM_API_KEY=在这里填入你的智谱APIKey
# MODELSCOPE_API_KEY=ms-xxx    # LLM_PROVIDER=modelscope 时填
# SILICONFLOW_API_KEY=sk-xxx   # LLM_PROVIDER=siliconflow 时填
# DEEPSEEK_API_KEY=sk-xxx      # LLM_PROVIDER=deepseek 时填

# 可选：覆盖预设的模型名与地址（一般无需改动）
# LLM_MODEL=glm-4-flash
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ===== 数据库类型 =====
# mysql（默认）：连真实 MySQL（本地 / 云端），需填下方 DB_* 全部变量
# sqlite         ：本地开发零依赖模式，免安装/免密码/免建库，便于先跑通全链路
DB_TYPE=mysql

# ----- MySQL 模式（DB_TYPE=mysql 时生效）-----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填入本地MySQL密码
DB_NAME=resume_optimizer

# ----- SQLite 模式（DB_TYPE=sqlite 时生效）-----
DB_SQLITE_PATH=./resume_optimizer.db

# ===== 本地/离线验证开关 =====
# 设为 1 时 LLM 返回固定模拟文本，无需真实 API Key 即可验证缓存命中与智能匹配
MOCK_LLM=0

# ===== 语义缓存（三级缓存的第三级，前两级是 内存LRU / MySQL精确键）=====
# 精确键命中率在真实场景通常很低（用户很少逐字重复提交），语义层让
# 「改了几个字、调了语序」的简历也能复用上次分析。
# 防误命中三重约束：①只在同一个岗位分区内比较 ②高阈值 ③版本隔离
SEMANTIC_CACHE_ENABLED=1
# 相似度阈值（余弦）。调低→命中率高但可能错配；调高→更安全但命中少。建议 0.90~0.97
SEMANTIC_CACHE_THRESHOLD=0.95
# 每个岗位分区最多扫描多少条做相似比较（防止全表扫；量大应换专用向量库）
SEMANTIC_CACHE_SCAN=200
# 缓存版本：prompt / 模型 / 向量配置变化时需改它，旧缓存自动失效
CACHE_VERSION=v1

# ===== 文本向量（语义缓存 / 语义匹配用）=====
# local（默认）：本地分词+特征哈希，零依赖、无需下载模型、离线可用
# api         ：调用兼容 OpenAI 的 /embeddings 接口，语义更准但需联网与密钥
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=256
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=embedding-3

# ===== CORS（生产环境填入前端域名，逗号分隔）=====
# BACKEND_CORS_ORIGINS=https://your-frontend.domain
